# titoForce configuration. Copy to .env (never commit it) or export these variables.
# Every setting is optional; the defaults suit local evaluation.

# --- Server ---------------------------------------------------------------
# TITO_PORT=3000
# TITO_HOST=127.0.0.1            # use 0.0.0.0 inside containers
# TITO_LOG_LEVEL=info            # debug/trace also log every request
# TITO_TRUST_PROXY=false         # true when behind a reverse proxy, so rate limits see real client IPs
# TITO_WEB_DIST=apps/web/dist    # built web app served by the API server

# --- Database -------------------------------------------------------------
# SQLite file (default: data/titoforce.db) or PostgreSQL:
# TITO_DATABASE_URL=sqlite:./data/titoforce.db
# TITO_DATABASE_URL=postgres://titoforce:secret@localhost:5432/titoforce

# --- First start ----------------------------------------------------------
# Demo data uses the well-known password "titoforce". It is loaded by default
# unless NODE_ENV=production; set false for any real deployment.
# TITO_SEED_DEMO=true
# Administrator created on first start. If no password is set, a random one is
# generated and printed once to stdout.
# TITO_ADMIN_EMAIL=admin@example.com
# TITO_ADMIN_PASSWORD=

# --- Cookies --------------------------------------------------------------
# With NODE_ENV=production session cookies are Secure (HTTPS only).
# Set true only to test a production build over plain HTTP.
# TITO_INSECURE_COOKIES=false

# --- AI agents ------------------------------------------------------------
# Without a key, agents run on the built-in offline rules engine.
# TITO_AI_PROVIDER=openai        # openai | anthropic | offline (auto-detected from the keys below)
# TITO_AI_MODEL=                 # defaults: gpt-4.1-mini (openai), claude-sonnet-4-5 (anthropic)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint, e.g. http://localhost:11434/v1 for Ollama
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# --- Email, calendars and phone -------------------------------------------
# Setup > Email, Calendar & Phone shows the redirect and webhook URLs to
# register with each provider.
# Address people and providers reach titoForce at, used in OAuth redirects,
# Twilio webhooks and calendar links (default: http://localhost:<TITO_PORT>).
# TITO_PUBLIC_URL=https://crm.example.com
# Encrypts stored mailbox and calendar credentials. Required in production to
# connect accounts. If it changes, people have to reconnect their accounts.
# Generate one with: openssl rand -base64 32
# TITO_SECRET_KEY=
# Organization relay for people without a connected mailbox:
# TITO_SMTP_URL=smtps://user:pass@smtp.example.com:465
# TITO_EMAIL_FROM=crm@example.com
# Gmail and Google Calendar (OAuth client of type "Web application"):
# TITO_GOOGLE_CLIENT_ID=
# TITO_GOOGLE_CLIENT_SECRET=
# Outlook mail and calendar in Microsoft 365 (Microsoft Entra app registration):
# TITO_MICROSOFT_CLIENT_ID=
# TITO_MICROSOFT_CLIENT_SECRET=
# TITO_MICROSOFT_TENANT=common   # your tenant ID if the app only accepts your organization's accounts
# Phone calls through Twilio (all three are needed):
# TITO_TWILIO_ACCOUNT_SID=
# TITO_TWILIO_AUTH_TOKEN=
# TITO_TWILIO_NUMBER=+14155550100
# TITO_DEFAULT_CALLING_CODE=1    # for phone numbers written without a country code
# TITO_SYNC_INTERVAL_MINUTES=5   # 0 turns background mailbox and calendar sync off
# TITO_ATTACHMENT_MAX_MB=10      # largest file that can be uploaded or attached
# TITO_ALLOW_PRIVATE_NETWORK=false   # true allows mail servers and calendars on private networks (testing only)
